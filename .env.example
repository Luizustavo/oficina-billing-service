PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
DATABASE_URL=postgresql://billing_user:billing_pass@localhost:5432/billing_db
JWT_SECRET=dev-jwt-secret
# Opcional: sem ela a mensageria fica desligada e o outbox só acumula.
RABBITMQ_URL=amqp://user:pass@localhost:5672/oficina
# Credenciais de teste do Mercado Pago (painel de desenvolvedor). PUBLIC_BASE_URL é a URL pública que recebe o webhook.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
# Opcional: sem ela a idempotência e a trava usam memória local.
REDIS_URL=redis://localhost:6379
